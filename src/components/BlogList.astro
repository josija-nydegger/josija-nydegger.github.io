---
// Blog auf der Startseite: die 3 neuesten Beiträge der eigenen Sprache, knapp (Titel und Datum),
// darunter der Link zur Übersicht /blog/ bzw. /en/blog/ (dort ausführlich mit Beschreibung und Tags).
import { i18n, formatDate, type Lang } from '../data/i18n';
import { getPosts } from '../lib/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = i18n[lang];
const posts = (await getPosts(lang)).slice(0, 3);
---
<section id="blog">
  <h2>{t.blog} <a class="rss" href={t.feedUrl} title={t.rssTitle}>RSS</a></h2>
  {posts.length > 0 ? (
    <>
      <div class="list">
        {posts.map(post => (
          <a class="item" href={post.url}>
            <div class="item-head">
              <p class="item-title">{post.title}</p>
              <span class="item-year">{formatDate(post.date, lang)}</span>
            </div>
          </a>
        ))}
      </div>
      <p class="page-note"><a href={t.blogUrl}>{t.allPosts} →</a></p>
    </>
  ) : (
    <p class="item-sub">{t.noPosts}</p>
  )}
</section>
