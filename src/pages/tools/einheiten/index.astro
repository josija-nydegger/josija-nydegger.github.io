      <div class="theme" role="group" aria-label="Farbschema" hidden>
        <button type="button" data-theme="light" aria-label="Hell" title="Hell">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>
        <button type="button" data-theme="dark" aria-label="Dunkel" title="Dunkel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
        <button type="button" data-theme="system" aria-label="System" title="System">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
        </button>
      </div>
    </div>
  </footer>
</main>

<script>
// Oberfläche des Einheiten-Umrechners. Die Rechenlogik liegt in src/lib/einheiten.ts (ohne DOM, getestet).
import { convert, G_DEFAULT, SIG_DEFAULT, type Dim, type Outcome, type Row, type Success } from '../../../lib/einheiten';

const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
const input = $<HTMLInputElement>('q');
const sigSel = $<HTMLSelectElement>('sig');
const gButtons = [...document.querySelectorAll<HTMLButtonElement>('.seg button')];

// ---------- Zustand (in der Adresszeile, wie bei den übrigen Tools) ----------
type State = { q: string; g: number; d: number };
const G_OPTIONS = [9.81, 10];
const SIG_OPTIONS = [2, 3, 4, 5, 6, 8, 10];
const DEFAULTS: State = { q: '', g: G_DEFAULT, d: SIG_DEFAULT };

/** Werte aus dem Link prüfen, bevor sie verwendet werden */
function sanitize(s: unknown): State {
  const d = { ...DEFAULTS };
  if (!s || typeof s !== 'object') return d;
  const o = s as Record<string, unknown>;
  if (typeof o.q === 'string') d.q = o.q.slice(0, 200);
  if (typeof o.g === 'number' && G_OPTIONS.includes(o.g)) d.g = o.g;
  if (typeof o.d === 'number' && SIG_OPTIONS.includes(o.d)) d.d = o.d;
  return d;
}
function readHash(): State {
  try {
    if (location.hash.length > 1) return sanitize(JSON.parse(decodeURIComponent(location.hash.slice(1))));
  } catch (e) { /* ungültiger Link: Standardwerte */ }
  return { ...DEFAULTS };
}
let state = readHash();
function save() {
  const isDefault = state.q === '' && state.g === DEFAULTS.g && state.d === DEFAULTS.d;
  try {
    history.replaceState(null, '', isDefault ? location.pathname : '#' + encodeURIComponent(JSON.stringify(state)));
  } catch (e) { /* z. B. in eingebetteten Vorschauen */ }
}

// ---------- Verlauf und Favoriten (localStorage, jeder Zugriff abgesichert) ----------
const KEY_HIST = 'einheiten:verlauf';
const KEY_FAV = 'einheiten:favoriten';
function load(key: string, max: number): string[] {
  try {
    const v: unknown = JSON.parse(localStorage.getItem(key) || '[]');
    return Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string' && x.length > 0 && x.length <= 200).slice(0, max) : [];
  } catch (e) {
    return [];
  }
}
function store(key: string, list: string[]) {
  try { localStorage.setItem(key, JSON.stringify(list)); } catch (e) { /* privates Fenster, Speicher voll */ }
}
let hist = load(KEY_HIST, 20);
let favs = load(KEY_FAV, 30);

// ans: letztes mit Enter oder Kopieren übernommenes Hauptresultat (SI-Wert, Dimension, Anzeige)
const KEY_ANS = 'einheiten:ans';
type Ans = { value: number; dim: Dim; text: string };
function loadAns(): Ans | null {
  try {
    const v: unknown = JSON.parse(localStorage.getItem(KEY_ANS) || 'null');
    if (!v || typeof v !== 'object') return null;
    const o = v as Record<string, unknown>;
    const dim = o.dim;
    if (typeof o.value !== 'number' || !isFinite(o.value) || typeof o.text !== 'string') return null;
    if (!Array.isArray(dim) || dim.length !== 4 || !dim.every(x => Number.isInteger(x) && Math.abs(x) <= 12)) return null;
    return { value: o.value, dim: dim as Dim, text: o.text.slice(0, 60) };
  } catch (e) {
    return null;
  }
}
let ans = loadAns();
function setAns(r: Success) {
  if (!r.result) return; // Neigungen: kein ans
  ans = { value: r.result.value, dim: r.result.dim, text: r.main.display };
  try { localStorage.setItem(KEY_ANS, JSON.stringify(ans)); } catch (e) { /* nur bis zum Neuladen */ }
  renderAns();
}
function renderAns() {
  $('ans-line').hidden = !ans;
  $('ans-val').textContent = ans ? ans.text : '';
}
/** Kopieren und als ans übernehmen */
function take(r: Success, text: string) {
  setAns(r);
  void copy(text);
}

function addHistory(q: string) {
  const t = q.trim();
  if (!t) return;
  hist = [t, ...hist.filter(h => h !== t)].slice(0, 20);
  store(KEY_HIST, hist);
  renderSaved();
}

// ---------- Kopieren mit kurzer Bestätigung ----------
let toastTimer = 0;
function toast(text: string) {
  const el = $('toast');
  el.textContent = text;
  el.hidden = false;
  clearTimeout(toastTimer);
  toastTimer = window.setTimeout(() => { el.hidden = true; }, 1600);
}
async function copy(text: string) {
  let ok = false;
  try {
    await navigator.clipboard.writeText(text); // braucht HTTPS (oder localhost)
    ok = true;
  } catch (e) { /* kein Zugriff auf die Zwischenablage */ }
  toast(ok ? 'Kopiert: ' + text : 'Kopieren nicht möglich');
  if (ok) addHistory(input.value);
}

// "URL kopieren": Link mit der aktuellen Eingabe (#...), auch in der installierten App ohne Adresszeile.
// Ohne JavaScript bleibt der Button ausgeblendet.
const urlBtn = $<HTMLButtonElement>('copy-url');
urlBtn.hidden = false;
urlBtn.addEventListener('click', async () => {
  save();
  try {
    await navigator.clipboard.writeText(location.href);
    toast('Link kopiert');
  } catch (e) {
    toast('Kopieren nicht möglich');
  }
});

// ---------- Darstellung ----------
let current: Outcome | null = null;

function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string): HTMLElementTagNameMap[K] {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}

function rowsTable(rows: Row[]): HTMLTableElement {
  const table = el('table', 'results');
  const tb = el('tbody');
  for (const r of rows) {
    const tr = el('tr', r.input ? 'is-input' : '');
    tr.tabIndex = 0;
    tr.title = 'Klicken zum Kopieren: ' + r.copy;
    tr.append(el('td', 'num', r.text));
    tr.append(el('td', 'unit', r.unit === '1:n' ? '' : r.unit));
    tr.append(el('td', 'note', r.input ? 'Eingabe' : ''));
    const go = () => { if (current && current.ok) take(current, r.copy); };
    tr.addEventListener('click', go);
    tr.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
    });
    tb.append(tr);
  }
  table.append(tb);
  return table;
}

function render() {
  const r = convert(state.q, { g: state.g, sig: state.d, ans });
  current = r;
  const ok = !!r && r.ok;
  $('empty').hidden = !!r;
  $('err').hidden = !r || r.ok;
  $('main').hidden = !ok;
  $('hints').hidden = true;
  $('steps-wrap').hidden = true;
  $('groups').replaceChildren();
  $<HTMLButtonElement>('fav').disabled = !ok;
  $('clear').hidden = state.q === '';
  $('fav').setAttribute('aria-pressed', String(favs.includes(state.q.trim())));
  $('fav').textContent = favs.includes(state.q.trim()) ? '★' : '☆';
  if (!r) return;
  if (!r.ok) {
    $('err').textContent = r.error;
    return;
  }
  $('main-big').textContent = (r.groups.length ? '' : r.input + ' = ') + r.main.display;
  const sub = $('main-sub');
  sub.replaceChildren(r.groups.length ? r.input + ' · ' + r.category : r.category);
  if (r.mainG) sub.append(' · ', el('span', 'g', 'mit g = ' + String(r.mainG) + ' m/s²'));
  const hints = $('hints');
  hints.replaceChildren(...r.hints.map(h => el('li', '', h)));
  hints.hidden = r.hints.length === 0;
  for (const g of r.groups) {
    $('groups').append(el('p', 'group-title', g.title), rowsTable(g.rows));
  }
  $('steps').replaceChildren(...r.steps.map(s => el('div', '', s)));
  $('steps-wrap').hidden = r.steps.length === 0;
}

function renderSaved() {
  const favWrap = $('favs');
  favWrap.replaceChildren(...favs.map(f => {
    const wrap = el('span', 'chip-wrap');
    const b = el('button', 'chip', f);
    b.type = 'button';
    b.addEventListener('click', () => setQuery(f));
    const x = el('button', 'chip-x', '×');
    x.type = 'button';
    x.title = 'Favorit entfernen';
    x.setAttribute('aria-label', 'Favorit entfernen: ' + f);
    x.addEventListener('click', () => {
      favs = favs.filter(v => v !== f);
      store(KEY_FAV, favs);
      renderSaved();
      render();
    });
    wrap.append(b, x);
    return wrap;
  }));
  $('favs-empty').hidden = favs.length > 0;
  $('hist').replaceChildren(...hist.map(h => {
    const li = el('li');
    const b = el('button', '', h);
    b.type = 'button';
    b.addEventListener('click', () => setQuery(h));
    li.append(b);
    return li;
  }));
  $('hist-empty').hidden = hist.length > 0;
  $('hist-clear').hidden = hist.length === 0;
}

function syncControls() {
  input.value = state.q;
  sigSel.value = String(state.d);
  gButtons.forEach(b => b.setAttribute('aria-pressed', String(Number(b.dataset.g) === state.g)));
}

function setQuery(q: string) {
  state.q = q;
  input.value = q;
  histIdx = -1;
  save();
  render();
  input.focus();
}

// ---------- Eingabe und Tastatur ----------
let histIdx = -1;   // -1 = eigene Eingabe, 0 = neuester Verlaufseintrag
let draft = '';

input.addEventListener('input', () => {
  state.q = input.value;
  histIdx = -1;
  save();
  render();
});

input.addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    e.preventDefault();
    if (current && current.ok) take(current, current.main.copy);
  } else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
    if (!hist.length) return;
    e.preventDefault();
    if (e.key === 'ArrowUp') {
      if (histIdx >= hist.length - 1) return;
      if (histIdx === -1) draft = input.value;
      histIdx++;
    } else {
      if (histIdx === -1) return;
      histIdx--;
    }
    const v = histIdx === -1 ? draft : hist[histIdx];
    input.value = v;
    state.q = v;
    save();
    render();
    input.setSelectionRange(v.length, v.length);
  } else if (e.key === 'Escape') {
    if (input.value) {
      e.preventDefault();
      setQuery('');
    }
  }
});

// "/" oder Strg/Cmd+K springt ins Eingabefeld
document.addEventListener('keydown', e => {
  const t = e.target as HTMLElement;
  const typing = t instanceof HTMLInputElement || t instanceof HTMLSelectElement || t instanceof HTMLTextAreaElement;
  if ((e.key === '/' && !typing) || (e.key.toLowerCase() === 'k' && (e.ctrlKey || e.metaKey))) {
    e.preventDefault();
    input.focus();
    input.select();
  }
});

input.addEventListener('blur', () => {
  if (current && current.ok) addHistory(input.value);
});

// Löschen-Button: Fokus bleibt im Feld (auf dem Handy bleibt die Tastatur offen)
const clearBtn = $<HTMLButtonElement>('clear');
clearBtn.addEventListener('pointerdown', e => e.preventDefault());
clearBtn.addEventListener('mousedown', e => e.preventDefault());
clearBtn.addEventListener('click', () => setQuery(''));

$('copy-main').addEventListener('click', () => {
  if (current && current.ok) take(current, current.main.copy);
});

$('fav').addEventListener('click', () => {
  const q = state.q.trim();
  if (!q) return;
  favs = favs.includes(q) ? favs.filter(f => f !== q) : [q, ...favs].slice(0, 30);
  store(KEY_FAV, favs);
  renderSaved();
  render();
  toast(favs.includes(q) ? 'Als Favorit gespeichert' : 'Favorit entfernt');
});

gButtons.forEach(b => b.addEventListener('click', () => {
  state.g = Number(b.dataset.g);
  syncControls();
  save();
  render();
}));
sigSel.addEventListener('change', () => {
  state.d = Number(sigSel.value);
  save();
  render();
});

document.querySelectorAll<HTMLButtonElement>('#examples .chip').forEach(b => {
  b.addEventListener('click', () => setQuery(b.dataset.q || ''));
});

$('hist-clear').addEventListener('click', () => {
  hist = [];
  store(KEY_HIST, hist);
  renderSaved();
});

$('reset').addEventListener('click', () => {
  state = { ...DEFAULTS };
  syncControls();
  save();
  render();
  input.focus();
});

window.addEventListener('hashchange', () => {
  state = readHash();
  syncControls();
  render();
});

window.addEventListener('beforeprint', () => { $<HTMLDetailsElement>('steps-wrap').open = true; });

syncControls();
render();
renderSaved();
renderAns();
input.focus();

// Hell / Dunkel / System: wie in src/layouts/Base.astro, gleicher Speicherschlüssel "theme".
(function () {
  const root = document.documentElement;
  const group = document.querySelector<HTMLElement>('.theme');
  if (!group) return;
  const buttons = group.querySelectorAll<HTMLButtonElement>('button');
  function apply(theme: string | undefined) {
    if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
    else { delete root.dataset.theme; theme = 'system'; }
    try {
      if (theme === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', theme);
    } catch (e) { /* ohne Speicher gilt die Wahl nur bis zum Neuladen */ }
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.theme === theme)));
  }
  buttons.forEach(b => b.addEventListener('click', () => apply(b.dataset.theme)));
  apply(root.dataset.theme);
  group.hidden = false;
})();

// Besucherstatistik (Umami): zählen, wie oft die App installiert wird (ohne weitere Angaben)
window.addEventListener('appinstalled', () => {
  (window as { umami?: { track: (name: string) => void } }).umami?.track('App installiert');
});

// Offline-Betrieb als App: Service Worker nur für dieses Tool (Scope /tools/einheiten/), nicht in "npm run dev"
if (import.meta.env.PROD && 'serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/tools/einheiten/sw.js', { scope: '/tools/einheiten/' }).catch(() => { /* ohne Offline-Betrieb weiter */ });
  });
}
</script>
</body>
</html>
