---
// Englische Blogbeiträge unter /en/blog/<slug>/ (Quelle: src/content/blog/en/).
import { render } from 'astro:content';
import Post from '../../../../layouts/Post.astro';
import { getPosts, type Post as P } from '../../../../lib/posts';

export async function getStaticPaths() {
  return (await getPosts('en')).map(post => ({ params: { slug: post.url.split('/').at(-2) }, props: { post } }));
}
const { post } = Astro.props as { post: P };
const { Content } = await render(post.entry);
---
<Post post={post}><Content /></Post>
