---
// Startseite (English), /en/. Änderungen auch in src/pages/index.astro nachführen.
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
---
<Base
  lang="en"
  ref="home"
  description="Personal website of Josija Nydegger – civil engineering student at BFH, academic work, projects and a blog on structural engineering, BIM and digital construction."
>

  <!-- ===== Header ===== -->
  <div class="header">
    <img class="avatar" src="/images/profil.jpg" alt="Josija Nydegger" onerror="this.style.display='none'">
    <div>
      <h1>Josija Nydegger</h1>
      <div class="meta">Civil Engineering · Bern University of Applied Sciences</div>
    </div>
  </div>

  <!-- ===== Bio ===== -->
  <section style="margin-top:0">
    <p>I'm a civil engineering student living in Lyss with my wife Prisca, and I'm interested in making engineering work easier with custom software.</p>

    <h3>Currently</h3>
    <p>
      I study civil engineering part-time at <a href="https://www.bfh.ch/en/">Bern University of Applied Sciences</a> in Burgdorf
      and work as a working student in infrastructure engineering at <a href="https://www.bsb-partner.ch/">BSB + Partner</a> in Bern.
      In November 2026, I'm moving to structural engineering for buildings at <a href="https://www.baukonstrukt.ch/">Baukonstrukt AG</a> in Biel.
    </p>

    <h3>Focus areas</h3>
    <ul class="bullets">
      <li>Structural engineering</li>
      <li>Digital construction and BIM (e.g. with IfcOpenShell)</li>
      <li>Numerical simulation</li>
    </ul>

    <h3>Background</h3>
    <p>
      Before that, I studied civil engineering at ETH Zurich and completed a first year of computer science.
      In my bachelor's thesis, I investigated the fluid-structure interaction of a wind turbine blade in COMSOL.
      After that, I worked in the social sector: in the office of the social services department in Opfikon and,
      during my Swiss civilian service, at a low-threshold counseling center in Zurich. I then returned to civil engineering.
    </p>

    <h3>Outside of work</h3>
    <p>
      I build small tools (<a href="https://github.com/josija-nydegger">GitHub</a>)
      and run anything from 10K to marathon distance (<a href="https://www.strava.com/athletes/8047977">Strava</a>).
    </p>

    <a class="button primary" href="/en/cv.html">View my CV →</a>
  </section>

  <!-- ===== Academic work (titles stay in the original language) ===== -->
  <section>
    <h2>Academic work</h2>
    <ul class="list">
      <!-- Add a PDF: upload the file to the "arbeiten" folder and add below the entry:
           <div class="tags"><a class="tag" href="/arbeiten/FILENAME.pdf" target="_blank" rel="noopener">PDF</a></div> -->
      <li class="item">
        <div class="item-head">
          <p class="item-title">Analyse der Einsturzwahrscheinlichkeit von Strassenbrücken in den USA</p>
          <span class="item-year">2026</span>
        </div>
        <p class="item-sub">Semester project, Bern University of Applied Sciences (in progress)</p>
      </li>
      <li class="item">
        <div class="item-head">
          <p class="item-title">Simulating the fluid-structure interaction of a wind turbine blade in COMSOL</p>
          <span class="item-year">2021</span>
        </div>
        <p class="item-sub">Bachelor's thesis, ETH Zurich · co-authored with Fabrizio Bruschetti</p>
        <div class="tags"><a class="tag" href="/arbeiten/bachelorarbeit-eth-windturbine.pdf" target="_blank" rel="noopener">PDF</a></div>
      </li>
    </ul>
  </section>

  <!-- ===== Projects ===== -->
  <section>
    <h2>Projects</h2>
    <ul class="list">
      <li class="item">
        <div class="item-head">
          <p class="item-title"><img class="item-icon" src="/images/projekte/qr-tool.png" alt="" width="40" height="40" loading="lazy">QR-tool</p>
        </div>
        <p class="item-sub">Prototype for one-way, network-free data transfer from a computer to a smartphone using a sequence of QR codes, with optional AES-256 encryption and fountain codes to recover lost frames.</p>
        <div class="tags">
          <a class="tag" href="https://github.com/josija-nydegger/QR-tool" target="_blank" rel="noopener">Code</a>
          <a class="tag" href="https://josija-nydegger.ch/QR-tool/QR-Reader.html" target="_blank" rel="noopener">Demo</a>
          <span class="tag">HTML / JavaScript</span>
        </div>
      </li>
      <li class="item">
        <div class="item-head">
          <p class="item-title"><img class="item-icon" src="/images/projekte/weather-bot.jpg" alt="" width="40" height="40" loading="lazy">weather-bot</p>
        </div>
        <p class="item-sub">Telegram bot that automatically sends a daily weather report, built on OpenWeatherMap and GitHub Actions.</p>
        <div class="tags">
          <a class="tag" href="https://github.com/josija-nydegger/weather-bot" target="_blank" rel="noopener">Code</a>
          <span class="tag">Python</span>
          <span class="tag">GitHub Actions</span>
        </div>
      </li>
    </ul>
  </section>

  <!-- ===== Blog (generated from src/content/blog/en, English posts only) ===== -->
  <BlogList lang="en" />

  <!-- ===== Contact ===== -->
  <section>
    <h2>Contact</h2>
    <p>The easiest way to reach me is on <a href="https://www.linkedin.com/in/josija-nydegger">LinkedIn</a><span class="email-wrap" hidden> or by email at <a class="email"></a></span>.</p>
    <div class="socials">
      <a href="https://www.linkedin.com/in/josija-nydegger" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://github.com/josija-nydegger" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.instagram.com/josija.nydegger" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.strava.com/athletes/8047977" target="_blank" rel="noopener">Strava</a>
      <a href="https://orcid.org/0009-0005-4270-2574" target="_blank" rel="noopener">ORCID</a>
    </div>
  </section>
</Base>
