---
// Bisher en/tools/index.html (Jekyll). Overview of the tools, list from src/data/tools.ts.
import Base from '../../../layouts/Base.astro';
import { tools } from '../../../data/tools';
---
<Base
  lang="en"
  ref="tools"
  title="Tools"
  description="Small web tools for structural design, structural analysis and BIM. They run in the browser; inputs never leave your computer."
>
<h1 class="page-title">Tools</h1>
<p class="page-intro">Small web tools for structural design, structural analysis and BIM that I build for my studies and work. They run in the browser; inputs never leave your computer. The tools are currently available in German only.</p>

<section>
  <ul class="list tool-list">
    {tools.map(tool => (
      <li class="item">
        <div class="item-head">
          <p class="item-title"><a href={tool.url}>{tool.title.en}</a></p>
          <span class="item-year">{tool.year}</span>
        </div>
        <p class="item-sub">{tool.description.en}</p>
        {tool.tags.en.length > 0 && <div class="tags">{tool.tags.en.map(tag => <span class="tag">{tag}</span>)}</div>}
      </li>
    ))}
  </ul>
</section>

<p class="page-note"><strong>Note:</strong> Aids for studies and preliminary design. They do not replace a check by a qualified engineer.</p>
</Base>
