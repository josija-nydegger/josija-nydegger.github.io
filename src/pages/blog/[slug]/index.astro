---
// Deutsche Blogbeiträge unter /blog/<slug>/ (Quelle: src/content/blog/).
import { render } from 'astro:content';
import Post from '../../../layouts/Post.astro';
import { getPosts, type Post as P } from '../../../lib/posts';

export async function getStaticPaths() {
  return (await getPosts('de')).map(post => ({ params: { slug: post.url.split('/').at(-2) }, props: { post } }));
}
const { post } = Astro.props as { post: P };
const { Content, remarkPluginFrontmatter } = await render(post.entry);
---
<Post post={post} math={remarkPluginFrontmatter.math === true}><Content /></Post>
